{
  "manifest_version": 3,
  "name": "WL Position Checker",
  "version": "1.5.1",
  "description": "Следит за позициями кабинета Whitelist, роботами AniScan и переносит оповещения в Telegram.",
  "permissions": ["cookies", "notifications", "alarms", "storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://raw.githubusercontent.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "key": ""
}
